{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "architecture:lender": "node scripts/quality/check-lender-architecture.js",
    "contracts:check": "node scripts/quality/check-api-contracts.js",
    "quality:gate": "node scripts/quality/run-workflow-gate.js",
    "quality:gate:local": "node scripts/quality/run-workflow-gate.js --skip-integration",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "backfill:lender-scope": "node scripts/backfill-lender-scope.js",
    "seed": "node scripts/seed/run.js",
    "seed:bulk": "node scripts/seed/run.js",
    "seed:bulk:check": "node scripts/seed/check.js",
    "seed:volume": "SEED_PROFILE=volume node scripts/seed/run.js",
    "seed:volume:check": "SEED_PROFILE=volume node scripts/seed/check.js",
    "seed:basic": "SEED_PROFILE=basic SEED_BATCH_ID=basic_dev SEED_RANDOM_SEED=smart-credit-basic node scripts/seed/run.js",
    "seed:basic:check": "SEED_PROFILE=basic SEED_BATCH_ID=basic_dev SEED_RANDOM_SEED=smart-credit-basic node scripts/seed/check.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:isolated": "node scripts/quality/run-isolated-e2e.js",
    "backfill:auth-users": "node scripts/backfill-auth-users.js",
    "migrate:loan-agreements": "node scripts/operations/migrations/migrate-loan-agreements.js",
    "migrate:loan-agreements:apply": "node scripts/operations/migrations/migrate-loan-agreements.js --apply",
    "migrate:disputes": "node scripts/operations/migrations/migrate-disputes.js",
    "migrate:disputes:apply": "node scripts/operations/migrations/migrate-disputes.js --apply",
    "migrate:admin-query-fields": "node scripts/operations/migrations/backfill-admin-query-fields.js",
    "migrate:admin-query-fields:apply": "node scripts/operations/migrations/backfill-admin-query-fields.js --apply",
    "migrate:kyc-consistency": "node scripts/operations/migrations/backfill-kyc-consistency.js",
    "migrate:kyc-consistency:apply": "node scripts/operations/migrations/backfill-kyc-consistency.js --apply",
    "migrate:kyc-consistency:validate": "node scripts/quality/validate-kyc-backfill.js",
    "migrate:notification-ownership": "node scripts/operations/migrations/migrate-notification-ownership.js",
    "migrate:notification-ownership:apply": "node scripts/operations/migrations/migrate-notification-ownership.js --apply",
    "migrate:payhere": "node scripts/operations/migrations/backfill-payhere-orders.js",
    "migrate:payhere:apply": "node scripts/operations/migrations/backfill-payhere-orders.js --apply",
    "create:admin": "node scripts/create-admin-user.js",
    "firestore:indexes:check": "node scripts/operations/firestore/deploy-firestore-indexes.js --check",
    "firestore:indexes:validate": "node scripts/quality/validate-firestore-indexes.js",
    "firestore:indexes:deploy": "node scripts/operations/firestore/deploy-firestore-indexes.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/websockets": "^11.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "firebase-admin": "^14.3.0",
    "geofire-common": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "puppeteer": "^25.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "firebase-tools": "^15.28.1",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
