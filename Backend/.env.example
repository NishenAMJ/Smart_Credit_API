JWT_SECRET=replace_with_a_strong_secret

# Firebase Configuration
# Required Firebase service account credentials
FIREBASE_PROJECT_ID=your_project_id
# Preferred option: point to a local service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
# On Cloud Run, omit service-account keys and attach a service identity with
# Firestore/Storage permissions; Application Default Credentials are used.

# Alternative option: inline service account fields
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Environment
NODE_ENV=development

# Server Port
PORT=3000
# Comma-separated web origins. Do not include paths or a trailing slash.
# Example: https://smart-credit.vercel.app,https://www.smartcredit.lk
CORS_ORIGINS=

# Security
QR_SECRET=replace_with_strong_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
LEGAL_AUDIT_HASH_SALT=replace_with_at_least_32_random_characters

# Borrower Configuration
FEATURED_LOAN_LIMIT=10
RECENT_ACTIVITY_LIMIT=5
STARTING_CREDIT_SCORE=300

# SMS
TEXTLK_API_TOKEN=""
TEXTLK_SENDER_ID=""
TEXTLK_API_URL=""

# Optional advertisement boost payments
# Card payments are enabled only when both PayHere values are configured.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Use a stable HTTPS origin. The backend appends the canonical /api callback paths.
PAYHERE_PUBLIC_BASE_URL=https://api.example.com
PAYHERE_SANDBOX=true
# Required in production for server-side lost-callback and chargeback reconciliation.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
# Bank transfers are enabled only when every bank-account value is configured.
BOOST_BANK_NAME=
BOOST_BANK_ACCOUNT_NAME=
BOOST_BANK_ACCOUNT_NUMBER=
BOOST_BANK_BRANCH=
# Optional plan-price overrides in LKR.
BOOST_PLAN_7_DAYS_FEE_LKR=1500
BOOST_PLAN_14_DAYS_FEE_LKR=2500
BOOST_PLAN_30_DAYS_FEE_LKR=4500

# AI Assistant (server-side only)
# Supported providers: openai, gemini
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional for compatible gateways; defaults to https://api.openai.com/v1
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Keep reasoning bounded so thinking tokens do not consume the response budget.
GEMINI_REASONING_EFFORT=low
GEMINI_MAX_TOKENS=2048
# Optional; defaults to Google's OpenAI-compatible API base URL
GEMINI_BASE_URL=
AI_MESSAGE_LIMIT_PER_5_MINUTES=20
AI_CONVERSATION_RETENTION_DAYS=30
# Use a private random value to pseudonymize safety identifiers.
AI_SAFETY_IDENTIFIER_SALT=
