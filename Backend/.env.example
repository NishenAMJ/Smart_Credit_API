JWT_SECRET=replace_with_a_strong_secret

# Firebase Configuration
# Required Firebase service account credentials
FIREBASE_PROJECT_ID=your_project_id
# Preferred option: point to a local service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json

# Alternative option: inline service account fields
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Environment
NODE_ENV=development

# Server Port
PORT=3000

# Security
QR_SECRET=replace_with_strong_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
LEGAL_AUDIT_HASH_SALT=replace_with_at_least_32_random_characters

# Borrower Configuration
FEATURED_LOAN_LIMIT=10
RECENT_ACTIVITY_LIMIT=5
STARTING_CREDIT_SCORE=300

# SMS
TEXTLK_API_TOKEN=""
TEXTLK_SENDER_ID=""
TEXTLK_API_URL=""

# AI Assistant (server-side only)
# Supported providers: openai, gemini
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional for compatible gateways; defaults to https://api.openai.com/v1
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional; defaults to Google's OpenAI-compatible API base URL
GEMINI_BASE_URL=
AI_MESSAGE_LIMIT_PER_5_MINUTES=20
AI_CONVERSATION_RETENTION_DAYS=30
# Use a private random value to pseudonymize safety identifiers.
AI_SAFETY_IDENTIFIER_SALT=
