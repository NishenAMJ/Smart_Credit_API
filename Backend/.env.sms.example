# SMS credentials stay on the backend. Never expose these as VITE_ variables.
SMS_API_URL=https://your-sms-provider.example/v1/messages
SMS_API_TOKEN=replace-with-provider-token
SMS_SENDER_ID=SmartCredit

# Optional provider authentication overrides.
# Defaults: Authorization: Bearer <SMS_API_TOKEN>
SMS_API_TOKEN_HEADER=Authorization
SMS_API_TOKEN_PREFIX=Bearer
