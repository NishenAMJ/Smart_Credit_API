# Copy these non-secret settings into Backend/.env and review them before seeding.
SEED_ENABLED=false
SEED_RANDOM_SEED=smart-credit-dev
SEED_BATCH_ID=bulk_dev
SEED_LENDER_COUNT=30
SEED_BORROWER_COUNT=70
SEED_LISTING_COUNT=60
SEED_APPLICATION_COUNT=150
SEED_LOAN_COUNT=80
SEED_MAX_WRITES=5000
SEED_WRITE_BATCH_SIZE=200
SEED_WRITE_DELAY_MS=100
SEED_DEFAULT_PASSWORD=SmartCredit@123

# Optional basic-edition overrides (defaults shown)
BASIC_SEED_RANDOM_SEED=smart-credit-basic
BASIC_SEED_BATCH_ID=basic_dev
BASIC_SEED_LENDER_COUNT=5
BASIC_SEED_BORROWER_COUNT=10
BASIC_SEED_LISTING_COUNT=8
BASIC_SEED_APPLICATION_COUNT=15
BASIC_SEED_LOAN_COUNT=8
BASIC_SEED_DEFAULT_PASSWORD=SmartCredit@123
